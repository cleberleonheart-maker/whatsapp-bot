# Prefixo principal dos comandos
PREFIX=!

# Prefixos alternativos (separados por vírgula)
ALT_PREFIXES=/

# Número do dono do bot (somente dígitos, com DDI). Ex: 5511999999999
OWNER_NUMBER=

# Pasta onde a sessão do WhatsApp é salva
SESSION_DIR=./auth_info

# Pasta de dados persistidos (XP, configurações de grupo)
DATA_DIR=./data/runtime

# Nome exibido no menu, status e perfil do WhatsApp
BOT_NAME=Fênix
BOT_DESCRIPTION=Fênix — bot de WhatsApp com piadas, jogos e utilidades
BOT_LOGO=./assets/fenix-logo.png

# Timezone usado em comandos de data/hora
TZ=America/Sao_Paulo

# Limites e comportamento
RATE_LIMIT=12
COOLDOWN_MS=2500
AUTO_READ=true
AUTO_PRESENCE=true

# Moderação padrão em grupos recém-criados no bot
WELCOME_ENABLED=true
ANTILINK_DEFAULT=false
FILTER_DEFAULT=false

# Sistema de XP
XP_PER_MESSAGE=3

# Reconexão
RECONNECT_DELAY_MS=5000

# Logs: info | debug
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE=./data/runtime/bot.log
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5
LOG_SESSION_ERRORS=false
LOG_INCOMING_MESSAGES=false

# Instância única e alertas de sessão
INSTANCE_LOCK_FILE=./data/runtime/bot.lock
HEALTH_ALERTS=true
HEALTH_ALERT_JID=

# Por padrão a sessão é preservada. Mude para true para apagar ao receber logout
CLEAR_SESSION_ON_LOGOUT=false

# Para vincular com código curto em vez de QR Code (somente dígitos, com DDI)
PAIRING_PHONE=

# Chave da API de OCR (padrão: chave de teste do OCR.Space)
OCR_API_KEY=helloworld

# Caminho do yt-dlp usado por !play e !playvid
# Deixe vazio para detectar automaticamente (inclui ~/.local/bin/yt-dlp)
YTDLP_BIN=

# Duração máxima aceita por !playvid, em segundos
VIDEO_LIMIT_SECONDS=600
